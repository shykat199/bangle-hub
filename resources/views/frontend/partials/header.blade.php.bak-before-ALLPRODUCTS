<script>
$(function(){
    function onScroll(){
        var st = $(window).scrollTop();
        var btn = $('#backto-top');
        if (st > 300) btn.addClass('show-btn'); else btn.removeClass('show-btn');
    }
    onScroll();
    $(window).on('scroll', onScroll);

    /* ক্যাটাগরি বেশি হলে মেনু আর নিচে নামে না, পাশে সরে। মোবাইলে আঙুলে
       সোয়াইপ এমনিতেই চলে; ডেস্কটপে মাউস ড্র্যাগ আর উল্লম্ব চাকাকেও পাশে
       ঠেলে দিচ্ছি। ৫px-এর কম নড়লে সেটা ক্লিক ধরি, নইলে লিংকে যেতে গেলেই
       সামান্য নড়াচড়ায় নেভিগেশন আটকে যেত। */
    (function initCatbarSwipe(){
        var nav = document.querySelector('.zh-nav');
        if (!nav) return;

        nav.addEventListener('wheel', function (e) {
            if (nav.scrollWidth <= nav.clientWidth) return;
            if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
            nav.scrollLeft += e.deltaY;
            e.preventDefault();
        }, { passive: false });

        var down = false, startX = 0, startScroll = 0, moved = 0;

        nav.addEventListener('mousedown', function (e) {
            if (nav.scrollWidth <= nav.clientWidth) return;
            down = true; moved = 0;
            startX = e.pageX;
            startScroll = nav.scrollLeft;
            nav.classList.add('is-dragging');
        });

        window.addEventListener('mousemove', function (e) {
            if (!down) return;
            var dx = e.pageX - startX;
            moved = Math.abs(dx);
            if (moved > 3) e.preventDefault();
            nav.scrollLeft = startScroll - dx;
        });

        window.addEventListener('mouseup', function () {
            if (!down) return;
            down = false;
            nav.classList.remove('is-dragging');
        });

        nav.addEventListener('click', function (e) {
            if (moved > 5) { e.preventDefault(); e.stopPropagation(); }
            moved = 0;
        }, true);
    })();

    $('#backto-top').on('click', function(e){
        e.preventDefault();
        $('html, body').animate({scrollTop: 0}, 300);
    });

    // Sticky category bar shadow toggle
    var $catbar = $('#zhCatbar');
    if($catbar.length){
        var catTop = $catbar.offset().top;
        $(window).on('scroll', function(){
            if($(window).scrollTop() > catTop){
                $catbar.addClass('is-stuck');
            } else {
                $catbar.removeClass('is-stuck');
            }
        });
    }

    $(document).on('click', '.cart-dropdown-btn', function(){
        $('body').addClass('hide-header');
    });
    $(document).on('click', '.close-cart, .cart-close, .close, .cart-cancel, .cart-overlay, .closeModal', function(){
        $('body').removeClass('hide-header');
    });
    $(document).on('click', function(e){
        if (!$(e.target).closest('.cart-dropdown, .cart-dropdown-btn, #cart-dropdown, #cart_section, .cart-content-wrap').length) {
            $('body').removeClass('hide-header');
        }
    });

    $('#mobileMenu').on('click', '.zh-cat-name, .zh-sb-chip, .zh-subs a, .zh-sb-user', function(){
        var el = document.getElementById('mobileMenu');
        if(window.bootstrap){
            var off = bootstrap.Offcanvas.getInstance(el);
            if(off) setTimeout(function(){ off.hide(); }, 150);
        }
    });
});
</script>