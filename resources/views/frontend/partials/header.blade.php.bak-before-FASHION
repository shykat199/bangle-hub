    function onScroll(){
        var st = $(window).scrollTop();
        var btn = $('#backto-top');
        if (st > 300) btn.addClass('show-btn'); else btn.removeClass('show-btn');
    }
    onScroll();
    $(window).on('scroll', onScroll);

    $('#backto-top').on('click', function(e) {
        e.preventDefault(); $('html, body').animate({scrollTop:0}, '300');
    });

    /* ক্যাটাগরির নাম লম্বা হওয়ায় মেনু আগে দ্বিতীয় সারিতে নেমে যেত। এখন wrap
       বন্ধ, বদলে পাশে স্ক্রল হয় — মোবাইলে সোয়াইপ, ডেস্কটপে মাউস ড্র্যাগ বা
       shift+চাকা। ফেড দুটো শুধু যেদিকে আরও আইটেম আছে সেদিকেই দেখায়। */
    (function initMenuSwipe() {
        var row   = document.querySelector('.strides-menu-row');
        var track = document.querySelector('.strides-menu-inner');
        if (!row || !track) return;

        function updateFades() {
            var max = track.scrollWidth - track.clientWidth;
            row.classList.toggle('can-scroll-left',  track.scrollLeft > 4);
            row.classList.toggle('can-scroll-right', track.scrollLeft < max - 4);
        }

        track.addEventListener('scroll', updateFades, { passive: true });
        window.addEventListener('resize', updateFades);
        updateFades();

        // ট্র্যাকপ্যাডে অনেকেই কেবল উল্লম্ব চাকা ঘোরায় — সেটাকে পাশে ঠেলে দিই,
        // কিন্তু শুধু তখনই, যখন সত্যিই স্ক্রল করার মতো জায়গা আছে।
        track.addEventListener('wheel', function (e) {
            if (track.scrollWidth <= track.clientWidth) return;
            if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
            track.scrollLeft += e.deltaY;
            e.preventDefault();
        }, { passive: false });

        // মাউস ড্র্যাগ। ৫px-এর কম নড়লে সেটা ক্লিক ধরে নিই, নইলে লিংকে
        // ক্লিক করতে গেলেই সামান্য নড়াচড়ায় নেভিগেশন আটকে যেত।
        var down = false, startX = 0, startScroll = 0, moved = 0;

        track.addEventListener('mousedown', function (e) {
            if (track.scrollWidth <= track.clientWidth) return;
            down = true; moved = 0;
            startX = e.pageX;
            startScroll = track.scrollLeft;
            track.classList.add('is-dragging');
        });

        window.addEventListener('mousemove', function (e) {
            if (!down) return;
            var dx = e.pageX - startX;
            moved = Math.abs(dx);
            if (moved > 3) e.preventDefault();
            track.scrollLeft = startScroll - dx;
        });

        window.addEventListener('mouseup', function () {
            if (!down) return;
            down = false;
            track.classList.remove('is-dragging');
        });

        track.addEventListener('click', function (e) {
            if (moved > 5) { e.preventDefault(); e.stopPropagation(); }
            moved = 0;
        }, true);
    })();

    $(document).on('click', '.cart-dropdown-btn', function() {
        $('body').addClass('hide-header');
    });
    $(document).on('click', '.close-cart, .cart-close, .close, .cart-cancel, .cart-overlay, .closeModal', function() {
        $('body').removeClass('hide-header');

        // main.js এর sideOffcanvasToggle খোলার মুহূর্তে $('.sidebar-close') এ bind করে,
        // কিন্তু তখন সাইডবার ফাঁকা — X বাটনটা DOM এ আসে পরে AJAX এ। ফলে ওর
        // removeSideMenu() কখনো চলে না, আর body তে open + overflow:hidden আটকে
        // থেকে পেজ স্ক্রল বন্ধ হয়ে যায়। তাই এখানে নিজেরাই পুরো রিসেট করি।
        $('body').removeClass('open').css('overflow', '');
        $('#cart-dropdown, #cart_section, .cart-dropdown-wrap').removeClass('open show active');
        $('.closeMask').remove();
    });
    $(document).on('click', function(e) {
        if (!$(e.target).closest('.cart-dropdown, .cart-dropdown-btn, #cart-dropdown, #cart_section, .cart-content-wrap').length) {
            $('body').removeClass('hide-header');
        }
    });

    $('#mobileMenu').on('click', '.pmm-cat-link, .pmm-quick-item, .pmm-subcat-list a, .pmm-user-card', function(){
        var off = bootstrap.Offcanvas.getInstance(document.getElementById('mobileMenu'));
        if(off) setTimeout(function(){ off.hide(); }, 150);
    });

    $('#mobileSearchToggle').on('click', function(e){
        e.preventDefault();
        var panel = $('#mobileSearchPanel');
        var isOpen = panel.hasClass('open');
        panel.toggleClass('open');
        $(this).attr('aria-expanded', !isOpen);
        $(this).find('i').toggleClass('fa-search fa-times');
        if(!isOpen){
            setTimeout(function(){ $('#mobileSearchInput').trigger('focus'); }, 250);
        }
    });

    $(document).on('click', function(e){
        if(!$(e.target).closest('#mobileSearchPanel, #mobileSearchToggle').length){
            var panel = $('#mobileSearchPanel');
            if(panel.hasClass('open')){
                panel.removeClass('open');
                $('#mobileSearchToggle').attr('aria-expanded', 'false').find('i').removeClass('fa-times').addClass('fa-search');
            }
        }
    });
});
</script>