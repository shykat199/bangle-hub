    $data = getProductInfo($product);

    use App\Models\Variation;
    use App\Models\ProductStock;
    use Illuminate\Support\Str;

    // ✅ OPTIMIZED: Memoized — was Information::first() per product card (N+1)
    $info = getInfo();
    $curr = $info->currency ?? 'BDT';

    $productParam = $product->slug ?: $product->id;

    $isVariable = $product->type === 'variable';
    $isStockEnabled = productStockManaged($product);

    // আগে কার্ড শুধু variations.stock_quantity পড়ত আর ডিটেইল পেজ product_stocks —
    // তাই ডিটেইলে স্টক দেখালেও কার্ডে STOCK OUT দেখাত। এখন একটাই নিয়ম।
    $qtySource = resolveStock($product);

    // Manage Stock = No মানে প্রোডাক্ট বন্ধ, তাই সেটাও STOCK OUT হিসেবেই দেখাবে
    $isOut = (!$isStockEnabled || $qtySource <= 0);

    // ভ্যারিয়েবল প্রোডাক্টে দাম/ডিসকাউন্ট ভ্যারিয়েশনে থাকে, products.sell_price/after_discount এ না —
    // তাই আগে কার্ডে ভ্যারিয়েবল প্রোডাক্টের ছাড় (old price/OFF ব্যাজ) কখনো দেখাতো না,
    // ডিটেইল পেজে দেখাতো। এখন getProductInfo() থেকে পাওয়া ভ্যারিয়েশন-অ্যাওয়্যার দাম দিয়েই হিসাব হয়।
    if($isVariable){
        $oldPriceDisplay = (float)($data['old_price'] ?? 0);
        $hasDiscount = $oldPriceDisplay > (float)($data['price'] ?? 0);
        $discountAmount = $hasDiscount ? ($oldPriceDisplay - (float)($data['price'] ?? 0)) : 0;
    } else {
        $oldPriceDisplay = (float)($product->sell_price ?? 0);
        $hasDiscount = ($product->after_discount ?? 0) > 0;
        $discountAmount = 0;

        // সেল প্রাইস থেকে ডিসকাউন্ট প্রাইস মাইনাস করা হয়েছে
        if($hasDiscount){
            $p = (float)($product->sell_price ?? 0);
            $a = (float)($product->after_discount ?? 0);
            $discountAmount = $p - $a;
        }
    }

    // Currency Symbol Helper
    $curSymbol = '৳';
    if($curr == 'Dollar') $curSymbol = '$';
    elseif($curr == 'Euro') $curSymbol = '€';
    elseif($curr == 'Rupee') $curSymbol = '₹';

